# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local MonkeyMux build output
/remote/monkeymux/monkeymux

# Local agent runtime state
/.pi/

# Local Bundler dependencies
/vendor/bundle/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing
**/android/app/key.properties

# Firebase app configuration
**/android/app/google-services.json
**/android/app/src/*/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/ios/Runner/Firebase/*/GoogleService-Info.plist

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/app-previews
**/fastlane/test_output
**/fastlane/README.md
**/android/app/upload-keystore.jks

# Regenerated store media (published via scripts/store_assets.sh + CI artifacts)
/store/demo-videos/
/store-assets-manifest.json
/build/store-assets/
android/fastlane/metadata-*/android/*/images/*Screenshots/

# Local Go build of the MonkeyMux server (distributed via assets/monkeymux/bin/*.gz)
/remote/monkeymux/monkeymux
/remote/monkeymux/monkeymux.exe
